---
import BaseLayout from "../layouts/BaseLayout.astro";
import SupplementCategoriesOverview, { seoConfig, definedTermSetJsonLd } from "../components/SupplementCategoriesOverview";

const webPageJsonLd = JSON.stringify(seoConfig.jsonLd);
const termSetJsonLd = JSON.stringify(definedTermSetJsonLd);
---
<BaseLayout
  fullTitle={seoConfig.title}
  description={seoConfig.description}
  path="/supplement-categories-overview"
  breadcrumbItems={[
    { name: "Home", path: "" },
    { name: "Category overview", path: "/supplement-categories-overview" },
  ]}
>
  <script type="application/ld+json" set:html={webPageJsonLd}></script>
  <script type="application/ld+json" set:html={termSetJsonLd}></script>

  <h1>Supplements Singapore: Category Overview</h1>

  <SupplementCategoriesOverview />
</BaseLayout>
