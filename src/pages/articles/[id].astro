---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadArticle, listArticleIds } from "../../lib/content";

export async function getStaticPaths() {
  const ids = listArticleIds();
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const article = loadArticle(id!);
const { frontmatter } = article;

const BASE = "https://supplementsingapore.neoi.jp";
const articleUrl = `${BASE}/articles/${id}`;
const datePublished = frontmatter.date ?? "2025-01-01";
const dateModified  = frontmatter.dateModified ?? datePublished;

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description ?? "",
  url: articleUrl,
  inLanguage: "en-SG",
  datePublished,
  dateModified,
  author: {
    "@type": "Organization",
    name: "Supplements Singapore",
    url: BASE,
  },
  publisher: {
    "@type": "Organization",
    name: "Neoi — Health Supplements Singapore",
    url: BASE,
  },
  isPartOf: {
    "@type": "WebSite",
    name: "Supplements Singapore",
    url: BASE,
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "article p:first-child"],
  },
});
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  path={`/articles/${id}`}
  breadcrumbItems={[
    { name: "Home", path: "" },
    { name: frontmatter.title, path: `/articles/${id}` },
  ]}
>
  <script type="application/ld+json" set:html={articleJsonLd}></script>

  <h1>{frontmatter.title}</h1>
  <article set:html={article.html} />
  <p style="margin-top:32px"><a href="/">← Back to home</a></p>
</BaseLayout>
