---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq, { seoConfig, buildWebPageJsonLd, buildFaqPageJsonLd } from "./_Faq";

const webPageJsonLd = JSON.stringify(buildWebPageJsonLd());
const faqPageJsonLd = JSON.stringify(buildFaqPageJsonLd());
---
<BaseLayout
  fullTitle={seoConfig.title}
  description={seoConfig.description}
  path="/faq"
  breadcrumbItems={[
    { name: "Home", path: "" },
    { name: "FAQ", path: "/faq" },
  ]}
>
  <script type="application/ld+json" set:html={webPageJsonLd}></script>
  <script type="application/ld+json" set:html={faqPageJsonLd}></script>

  <h1>Supplements Singapore: Frequently Asked Questions</h1>

  <div class="disclaimer">
    General educational information only. Not medical or legal advice.
    For personal questions, consult a qualified clinician or pharmacist.
  </div>

  <Faq />
</BaseLayout>
