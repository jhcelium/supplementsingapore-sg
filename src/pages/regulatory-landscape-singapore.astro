---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegulatoryLandscapeSingapore, { seoConfig, definedTermSetJsonLd } from "../components/RegulatoryLandscapeSingapore";

const webPageJsonLd = JSON.stringify(seoConfig.jsonLd);
const termSetJsonLd = JSON.stringify(definedTermSetJsonLd);
---
<BaseLayout
  fullTitle={seoConfig.title}
  description={seoConfig.description}
  path="/regulatory-landscape-singapore"
  breadcrumbItems={[
    { name: "Home", path: "" },
    { name: "Regulatory landscape", path: "/regulatory-landscape-singapore" },
  ]}
>
  <script type="application/ld+json" set:html={webPageJsonLd}></script>
  <script type="application/ld+json" set:html={termSetJsonLd}></script>

  <h1>Supplements Singapore: Regulatory Landscape</h1>

  <RegulatoryLandscapeSingapore />
</BaseLayout>
