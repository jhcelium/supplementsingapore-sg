---
import site from "../../data/site.json";
interface Props {
  title?: string;
  description?: string;
  path?: string;
  fullTitle?: string;
}
const { title, description, path, fullTitle } = Astro.props;

const resolvedTitle = fullTitle ?? (title ? `${title} | ${site.siteName}` : site.siteName);
const canonical = `https://${site.domain}${path ?? "/"}`;
const desc = description ?? "";
const ogImage = `https://${site.domain}/supplements-singapore-guide.png`;
---
<title>{resolvedTitle}</title>
<meta name="robots" content="index,follow" />
{desc && <meta name="description" content={desc} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en-SG" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:title" content={resolvedTitle} />
{desc && <meta property="og:description" content={desc} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_SG" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Supplements Singapore — Practical Guide" />
<meta property="og:site_name" content={site.siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
{desc && <meta name="twitter:description" content={desc} />}
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Supplements Singapore — Practical Guide" />
