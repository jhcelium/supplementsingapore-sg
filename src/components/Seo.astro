---
import site from "../../data/site.json";
import { absoluteUrl, type BreadcrumbCrumb } from "../lib/seo-url";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  fullTitle?: string;
  /** Override default OG/Twitter image (absolute URL recommended). */
  ogImage?: string;
  /** Visible breadcrumb + BreadcrumbList JSON-LD. Omit on home. */
  breadcrumbItems?: BreadcrumbCrumb[];
}

const { title, description, path, fullTitle, ogImage: ogImageProp, breadcrumbItems } = Astro.props;

const resolvedTitle = fullTitle ?? (title ? `${title} | ${site.siteName}` : site.siteName);
const canonical = absoluteUrl(path);
const desc = description ?? "";
const defaultOg = `https://${site.domain}/supplements-singapore-guide.png`;
const ogImage = ogImageProp ?? defaultOg;

const breadcrumbJsonLd =
  breadcrumbItems && breadcrumbItems.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems.map((crumb, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: crumb.name,
          item: absoluteUrl(crumb.path === "" ? "/" : crumb.path),
        })),
      })
    : null;
---
<title>{resolvedTitle}</title>
<meta name="robots" content="index,follow" />
{desc && <meta name="description" content={desc} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en-SG" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:title" content={resolvedTitle} />
{desc && <meta property="og:description" content={desc} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_SG" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Supplements Singapore — Practical Guide" />
<meta property="og:site_name" content={site.siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
{desc && <meta name="twitter:description" content={desc} />}
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Supplements Singapore — Practical Guide" />

{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
)}
