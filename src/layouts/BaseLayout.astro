---
import Seo from "../components/Seo.astro";
import site from "../../data/site.json";
import { absoluteUrl, type BreadcrumbCrumb } from "../lib/seo-url";
import "../styles/editorial.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  fullTitle?: string;
  ogImage?: string;
  breadcrumbItems?: BreadcrumbCrumb[];
}
const { title, description, path, fullTitle, ogImage, breadcrumbItems } = Astro.props;

const showBreadcrumb = breadcrumbItems && breadcrumbItems.length > 0;
---
<!DOCTYPE html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      fullTitle={fullTitle}
      ogImage={ogImage}
      breadcrumbItems={breadcrumbItems}
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/faq">FAQ</a>
      </nav>
      <a href="https://supplement.neoi.jp/en" target="_blank" rel="noopener" class="header-logo" aria-label="Official Neoi Supplement Site">
        <img src="/neoi-logo.png" alt="supplement.neoi.jp" />
      </a>
    </header>

    <main class="site-main">
      {showBreadcrumb && (
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            {breadcrumbItems!.map((crumb, i) => {
              const isLast = i === breadcrumbItems!.length - 1;
              const href = absoluteUrl(crumb.path === "" ? "/" : crumb.path);
              return (
                <li class="breadcrumb-item">
                  {!isLast ? (
                    <a href={href}>{crumb.name}</a>
                  ) : (
                    <span class="breadcrumb-current">{crumb.name}</span>
                  )}
                </li>
              );
            })}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div>{site.siteName}</div>
      <div style="margin-top:4px">Educational content only. Not medical or treatment advice.</div>
      <div style="margin-top:8px">
        <a href={site.officialSite} target="_blank" rel="noopener noreferrer">
          Official Neoi Site
        </a>
      </div>
    </footer>
  </body>
</html>
